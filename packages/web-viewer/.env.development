# Stele CORS proxy URL. In dev this points at a local Cloudflare Worker
# launched via `pnpm --filter @stele/cors-proxy dev` (defaults to :8787).
# Override in .env.local (gitignored) to test a different proxy.
VITE_PROXY_URL=http://localhost:8787/fetch

# Stele publish endpoint — same worker as VITE_PROXY_URL, different route.
# Used by the Share button to upload local artifacts so the link works for
# the recipient. Returns { url, expiresAt }; artifacts retained for 24h.
VITE_PUBLISH_URL=http://localhost:8787/publish
